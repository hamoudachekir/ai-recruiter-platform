RXRESUME_URL=http://localhost:3000
# v4.4.6 has no API-key concept — the service logs in with these credentials
# (an account created on the self-hosted instance) via POST /api/auth/login.
RXRESUME_EMAIL=
RXRESUME_PASSWORD=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
MONGO_URI=mongodb://localhost:27017/ai_recruiter
MONGO_DB=ai_recruiter
CV_PARSER_URL=http://127.0.0.1:5002
TAILORED_CV_UPLOAD_DIR=../server/uploads/tailored-cvs
PORT=8014

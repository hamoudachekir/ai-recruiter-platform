FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY Backend/voice_engine/speech_stack/requirements.speech_stack.txt /tmp/requirements.txt
RUN pip install --upgrade pip && pip install -r /tmp/requirements.txt

COPY Backend/voice_engine /app/Backend/voice_engine

EXPOSE 8012

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8012/health || exit 1

CMD ["python", "-m", "uvicorn", "Backend.voice_engine.speech_stack.api_server:app", "--host", "0.0.0.0", "--port", "8012"]

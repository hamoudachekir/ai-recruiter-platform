FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    AGENT_PORT=8013

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY Backend/voice_engine/interview_agent/requirements.txt /tmp/agent-requirements.txt
RUN pip install --upgrade pip && pip install -r /tmp/agent-requirements.txt

COPY Backend/voice_engine /app/Backend/voice_engine

EXPOSE 8013

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8013/health || exit 1

CMD ["python", "-m", "Backend.voice_engine.interview_agent.agent_server"]

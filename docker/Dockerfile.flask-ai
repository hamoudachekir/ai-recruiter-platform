FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CLUSTERING_PORT=5006 \
    PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY Backend/server/AI/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip && pip install -r /tmp/requirements.txt \
    && python -m spacy download en_core_web_sm

COPY Backend/server/AI/ /app/Backend/server/AI/
COPY docker/scripts/start-flask-ai.sh /usr/local/bin/start-flask-ai.sh
RUN chmod +x /usr/local/bin/start-flask-ai.sh

WORKDIR /app/Backend/server/AI

EXPOSE 5000 5001 5002 5003 5006 7000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -fsS http://127.0.0.1:5001/health || exit 1

CMD ["start-flask-ai.sh"]

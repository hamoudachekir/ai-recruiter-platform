# Backend Node.js Server
BACKEND_PORT=3001
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=ai_recruiter
DB_NAME=ai_recruiter
MONGODB_DB_NAME=ai_recruiter
MONGO_URI=mongodb://localhost:27017/ai_recruiter

# Frontend
FRONTEND_PORT=5173
FRONTEND_LOGIN_PORT=5174

# Interview Scheduling Service (Python/FastAPI)
SCHEDULING_SERVICE_PORT=5004
SCHEDULING_SERVICE_HOST=0.0.0.0

# Google Calendar OAuth (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5004/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ai-recruiter.com
EMAIL_FROM_NAME=AI Recruiter Platform

# SendGrid Alternative
SENDGRID_API_KEY=

# Interview Configuration
INTERVIEW_DURATION_DEFAULT=60
WORKING_HOURS_START=09
WORKING_HOURS_END=17
LUNCH_START=12
LUNCH_END=13
SCHEDULING_DAYS_AHEAD=7
TIMEZONE_DEFAULT=UTC

# Python AI Services
FLASK_AI_PORT=5000
FLASK_QUIZ_PORT=5003

# YOLOv8 Vision Service (Object Detection)
YOLO_ENABLED=true
YOLO_SERVICE_URL=http://localhost:8001/detect-frame
YOLO_FRAME_INTERVAL_MS=1500
YOLO_TIMEOUT_MS=3000
YOLO_CONFIDENCE=0.25
YOLO_PHONE_CONFIDENCE=0.55
YOLO_BOOK_CONFIDENCE=0.55
YOLO_SCREEN_CONFIDENCE=0.60

# Post-Interview Report Polish (analysis_service LangGraph pipeline)
# When enabled, an LLM rewrites a STRICT WHITELIST of prose fields
# (transcriptSummary, finalRecommendation, technicalEvaluation.strengths/weaknesses)
# in the deterministic report. Numeric scores, vision/audio metrics, integrity
# alerts, and identity fields are NEVER touched. Polish failures are logged
# and the deterministic report is saved unchanged — they cannot fail the job.
REPORT_POLISH_ENABLED=false

# Provider used ONLY by the polish step (independent of LLM_PROVIDER).
# Supported: gemini | nvidia | anthropic | openai | ollama | echo
REPORT_POLISH_PROVIDER=gemini

# Google Gemini — free tier, no local model needed
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
REPORT_POLISH_MODEL=gemini-2.5-flash-lite

# Interview Agent LLM
# Supported: groq | nvidia | anthropic | openai | ollama | echo
LLM_PROVIDER=groq

# Groq (recommended for low-latency live interview turns)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional faster/lighter model:
# GROQ_MODEL=openai/gpt-oss-20b
AGENT_MAX_TOKENS=100
AGENT_TEMPERATURE=0.15
AGENT_TRANSCRIPT_TAIL_TURNS=8
AGENT_LLM_TIMEOUT_MS=6000
GROQ_REASONING_EFFORT=low

# NVIDIA NIM (optional fallback provider / report polish provider)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Google Gemini — used by the Candidate Comparison feature
# Free tier: 1 500 req/day, 1 M tokens/min, $0 cost
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY is already used by the report-polish step above;
# the comparison feature reads the same variable.
# Model override (default: gemini-2.0-flash)
COMPARISON_LLM_MODEL=gemini-2.0-flash

# Face Verification Service (Python/InsightFace + ONNXRuntime)
FACE_VERIFY_ENABLED=true
FACE_VERIFY_SERVICE_URL=http://localhost:8011
FACE_VERIFY_TIMEOUT_MS=5000
FACE_VERIFY_PHOTO_TIMEOUT_MS=3500
FACE_VERIFY_MODEL_PACK=buffalo_l
FACE_VERIFY_THRESHOLD=0.60
FACE_VERIFY_DET_SIZE=640
FACE_VERIFY_MAX_FRAMES=3
FACE_VERIFY_REQUIRED_FRAMES=3
FACE_VERIFY_MIN_MATCHING_FRAMES=2
FACE_VERIFY_FAIL_OPEN=false
FACE_VERIFY_START_GATE_MAX_AGE_MS=90000
FACE_VERIFY_IMAGE_MAX_BYTES=12582912
FACE_VERIFY_BRIGHTNESS_MIN=35
FACE_VERIFY_BRIGHTNESS_MAX=240
FACE_VERIFY_MIN_FACE_RATIO=0.12
FACE_VERIFY_MIN_BLUR_SCORE=18
FACE_VERIFY_PERIODIC_INTERVAL_MS=45000
VITE_FACE_VERIFY_TIMEOUT_MS=5000
VITE_FACE_VERIFY_LIVENESS_MIN_DELTA=3.5
VITE_FACE_VERIFY_PERIODIC_INTERVAL_MS=45000

# logging/Debug
DEBUG=false
LOG_LEVEL=INFO
